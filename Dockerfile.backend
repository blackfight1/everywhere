FROM golang:1.26-alpine AS builder
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /everywhere ./cmd/everywhere

FROM alpine:3.21
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=builder /everywhere /usr/local/bin/everywhere
COPY configs /app/configs
ENTRYPOINT ["everywhere"]
